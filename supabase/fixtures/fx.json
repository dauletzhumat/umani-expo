{
  "description": "FX book-value rules (DATABASE.md §4 examples and §5a R2/R4). Amounts are minor units as strings; base currency KZT. Shared by Jest (src/domain/fx/book-value.test.ts) and pgTAP.",
  "incoming": [
    { "name": "1 000 USD income at 505.00", "amount": "100000", "currency": "USD", "rate": "505.00", "expectedBase": "50500000" },
