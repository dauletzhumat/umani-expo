# Copy to .env.local (git-ignored) and fill in. Only EXPO_PUBLIC_* values reach the app bundle,
# so only public values belong here (CLAUDE.md rule 5). Never put the service-role key, the
# OpenAI key or provider secrets in this file.

# Local stack: `npx supabase status` prints both (API URL and the anon / publishable key).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in (Google Cloud → OAuth client IDs). Client IDs are public identifiers.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
