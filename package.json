{
  "name": "umani-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.108.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "i18next": "^27.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "fast-check": "^4.10.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "supabase": "3.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:domain": "expo lint src/domain scripts/check-domain-boundary.js scripts/gen-pgtap-fixtures.js",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "tsc --noEmit -p tsconfig.domain.json",
    "test": "node scripts/check-domain-boundary.js && jest",
    "test:watch": "jest --watch",
    "test:coverage": "node scripts/check-domain-boundary.js && jest --coverage",
    "db:fixtures": "node scripts/gen-pgtap-fixtures.js",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/gen-pgtap-fixtures.js && supabase test db",
    "db:types": "supabase gen types typescript --schema public,api > src/lib/supabase/database.types.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "!src/domain/**/*.test.ts",
      "!src/domain/**/index.ts"
    ],
    "coverageThreshold": {
      "./src/domain/": {
        "lines": 95,
        "branches": 95,
        "functions": 95,
        "statements": 95
      }
    }
  },
  "private": true
}
